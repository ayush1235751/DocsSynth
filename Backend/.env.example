# ==============================================================================
# DocsSynth Backend Environment Variables
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# OpenRouter API Key for Embeddings and Multi-Model LLM Inferences
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MongoDB Atlas or Local MongoDB Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MongoDB=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=DocsSynth
